# .NET 9 toolchain image — builds the native C# peer (entity-core-protocol-csharp)
# per protocol-generator/csharp/profile.toml. Mirrors containers/cargo +
# containers/c-toolchain.
#
# S1: builds run in this container, not on the host.
#
# PIN NOTE (S11 scope): the .NET SDK comes through fedora's reviewed dnf channel,
# so the ≥30-day-old "cool-down" floor does NOT apply here — that floor is for
# packages pulled straight from ecosystem registries with no human gate (NuGet,
# PyPI, npm, crates.io). For the C# peer that means the NuGet deps
# (System.Formats.Cbor, NSec.Cryptography, xUnit, a base58 lib) DO get the
# ≥30-day discipline; the SDK does not. We still pin the exact NVR for
# reproducibility (re-pin deliberately on rebuild; prefer a base-image digest pin
# for full repro). 9.0.10x supports net9.0 + C# 13 (profile language_version 13.0).
# RE-PIN (2026-07-27, cohort image-rot sweep): dotnet-sdk-9.0-9.0.117-1.fc43 aged out of
#   the fedora:43 `updates` repo (`No match for argument`), so the image would not build and
#   the csharp peer could not be validated. Verified inside fedora:43 on 2026-07-27: the
#   surviving NVRs are 9.0.109-1.fc43 (base) and 9.0.119-1.fc43 (updates). Re-pinned to
#   9.0.119-1.fc43 per the S11 distro-channel pin-for-repro rule.
# KOJI-PIN (2026-07-27, closing the rot class): dotnet-sdk-9.0 fetched from Koji's
# permanent build archive (containers/koji-fetch.sh), not the rolling dnf repo — see
# c-toolchain's Containerfile for the full rationale. SHA-256 recorded at fetch time.
# Its own transitive deps (dotnet-runtime-9.0 etc.) are left to resolve from the live
# repo as before — only re-koji-pin them too if they independently rot.
# Base pinned BY DIGEST, not by tag (fedora:43, resolved 2026-08-27).
# A tag is republished in place; a digest is not. Pinning the tag meant every
# image in this tree floated on whatever the registry served that day, which is
# not reproducible for anyone pulling the repo.
FROM registry.fedoraproject.org/fedora@sha256:6e1245e9a4a72ec879b9d681ebb464a6e9fd93eea36b4506d438aceb95a7da0b

# .NET 9 SDK, exact NVR. Pulls the matching 9.0 runtime + host as dependencies.
COPY containers/koji-fetch.sh /usr/local/bin/koji-fetch.sh
RUN chmod +x /usr/local/bin/koji-fetch.sh \
    && koji-fetch.sh dotnet9.0 9.0.119 1.fc43 \
        dotnet-sdk-9.0:adc47789499cbbb899f5ac685c2045798e527b8a6f310e307b0b39cdd3ff0970 \
    && dnf install -y /tmp/rpms/*.rpm \
    && rm -rf /tmp/rpms \
    && dnf clean all

# NuGet's package cache is BAKED INTO THE IMAGE, not mounted.
#
# It used to be `NUGET_PACKAGES=/nuget` fed by a host-local podman volume named
# kc-nuget, and csharp was consequently the ONE peer whose conformance run was not
# sealed offline: run-cohort-census.sh gave it a network namespace while all 45
# siblings ran --network=none. `dotnet restore` reaches nuget.org for the service
# index even when every package is already cached, so --network=none failed at
# restore rather than at download.
#
# That is a local accident wearing the shape of a recipe -- exactly what the
# 2026-08-27 cold-build work was about. An adopter with no kc-nuget volume gets
# NU1301 and no report at all, which is what a clean clone measured on 2026-09-02.
# Quiet, non-interactive CLI for clean conformance logs.
ENV NUGET_PACKAGES=/opt/nuget \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1 \
    DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 \
    DOTNET_CLI_HOME=/tmp

# Seed that cache from THE TREE'S OWN packages.lock.json, never from a restatement
# of the pins in this file. That is the rule the dart/haskell/python images already
# carry: a hand-maintained copy of the top-level pins lets the transitive closure
# float, and the rebuild then resolves something the committed lockfile does not
# describe (dart re-resolved source_maps 0.10.13 -> 0.10.14 exactly that way).
#
# Only the project and lock files are copied, never the sources: this layer must not
# be invalidated by an ordinary edit to the peer. If a project is ADDED and not
# listed here its restore below fails, which is the fail-closed direction.
COPY protocol-generator/csharp/src/EntityCore.Protocol/EntityCore.Protocol.csproj \
     protocol-generator/csharp/src/EntityCore.Protocol/packages.lock.json \
     /restore/src/EntityCore.Protocol/
COPY protocol-generator/csharp/samples/EntityCore.Protocol.Host/EntityCore.Protocol.Host.csproj \
     protocol-generator/csharp/samples/EntityCore.Protocol.Host/packages.lock.json \
     /restore/samples/EntityCore.Protocol.Host/
COPY protocol-generator/csharp/samples/EntityCore.Protocol.Smoke/EntityCore.Protocol.Smoke.csproj \
     protocol-generator/csharp/samples/EntityCore.Protocol.Smoke/packages.lock.json \
     /restore/samples/EntityCore.Protocol.Smoke/
COPY protocol-generator/csharp/test/EntityCore.Protocol.Conformance/EntityCore.Protocol.Conformance.csproj \
     protocol-generator/csharp/test/EntityCore.Protocol.Conformance/packages.lock.json \
     /restore/test/EntityCore.Protocol.Conformance/
COPY protocol-generator/csharp/test/EntityCore.Protocol.Tests/EntityCore.Protocol.Tests.csproj \
     protocol-generator/csharp/test/EntityCore.Protocol.Tests/packages.lock.json \
     /restore/test/EntityCore.Protocol.Tests/
COPY protocol-generator/csharp/test/EntityCore.Protocol.Agility/EntityCore.Protocol.Agility.csproj \
     /restore/test/EntityCore.Protocol.Agility/

# --locked-mode: an unsatisfiable lockfile fails the IMAGE BUILD, which is the right
# place to find out. -p:UseAppHost=false for the reason the Host csproj records: the
# apphost pack for this RID is published nowhere and is not needed to run a dll.
#
# Then PROVE the closure is complete by re-restoring with the network severed at the
# NuGet level (an empty source list). A seed that happens to be sufficient on the
# build host and short by one package for everyone else is the failure this whole
# layer exists to prevent, and only asking offline can tell the difference.
RUN set -eu; \
    PROJECTS="src/EntityCore.Protocol \
              samples/EntityCore.Protocol.Host \
              samples/EntityCore.Protocol.Smoke \
              test/EntityCore.Protocol.Conformance \
              test/EntityCore.Protocol.Tests \
              test/EntityCore.Protocol.Agility"; \
    for p in $PROJECTS; do \
      dotnet restore "/restore/$p" --locked-mode -p:UseAppHost=false; \
    done; \
    mkdir -p /tmp/no-sources; \
    for p in $PROJECTS; do \
      rm -rf "/restore/$p/obj"; \
      dotnet restore "/restore/$p" --locked-mode -p:UseAppHost=false \
        --source /tmp/no-sources; \
    done; \
    rm -rf /restore /tmp/no-sources

WORKDIR /work
