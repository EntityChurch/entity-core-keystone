# Node.js 24 LTS toolchain image — builds the native TypeScript peer
# (entity-core-protocol-typescript) per protocol-generator/typescript/profile.toml.
# Mirrors containers/dotnet9 + containers/cargo.
#
# S1: builds run in this container, not on the host.
#
# Why 24, not the containers/node20 stub: Node 20 (Iron) is EOL by mid-2026.
# Node 24 is the active LTS (since 2025-05-06; maintenance 2026-10-20; EOL
# 2028-04-30) and ships the native Ed25519 + Ed448 + raw-key crypto the profile
# relies on. The old empty containers/node20/ dir is retired.
#
# Build:
#   podman build -t entity-core-keystone/node24:latest -f containers/node24/Containerfile .
#
# PIN NOTE (S11 scope, same split as dotnet9): the Node runtime + npm come
# through fedora's reviewed dnf channel (human-gated), so the ≥30-day "cool-down"
# floor does NOT apply to the runtime — pin the exact NVR for reproducibility and
# re-verify on rebuild. The floor DOES apply to everything pulled from the npm
# registry (cborg, typescript, any optional @scure/@noble) — those live in the
# committed package-lock.json, each ≥30 days old (see
# research/evaluations/typescript.md + profile A-004). If fedora:43's nodejs
# stream is not 24.x, fall back to the official nodejs.org tarball pinned by
# exact version + SHA-256 (the reproducible alternative).
# Base pinned BY DIGEST, not by tag (fedora:43, resolved 2026-08-27).
# A tag is republished in place; a digest is not. Pinning the tag meant every
# image in this tree floated on whatever the registry served that day, which is
# not reproducible for anyone pulling the repo.
FROM registry.fedoraproject.org/fedora@sha256:6e1245e9a4a72ec879b9d681ebb464a6e9fd93eea36b4506d438aceb95a7da0b

# Node 24 LTS via the OFFICIAL nodejs.org tarball, SHA-256-pinned (S11).
# RESOLVED AT FIRST BUILD (2026-06-11): fedora:43's dnf `nodejs` stream is 22.22.2,
# NOT 24.x — so per this file's own PIN NOTE we take the documented fallback: the
# official tarball pinned by exact version + SHA-256 (the reproducible alternative).
# The profile commits to Node 24 LTS; this honors it. Node 24.16.0 (2026-05-21) was
# only ~21d old at build time (< S11's 30-day floor), so we pin 24.15.0 (2026-04-15,
# ~57d, LTS "Krypton") — clears the cool-down. Re-verify + re-pin deliberately on
# rebuild (newer 24.x, ≥30d old, with its published SHA-256).
ENV NODE_VERSION=24.15.0 \
    NODE_SHA256=472655581fb851559730c48763e0c9d3bc25975c59d518003fc0849d3e4ba0f6
RUN dnf install -y git xz tar && dnf clean all && \
    curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" && \
    echo "${NODE_SHA256}  node-v${NODE_VERSION}-linux-x64.tar.xz" | sha256sum -c - && \
    tar -xJf "node-v${NODE_VERSION}-linux-x64.tar.xz" -C /usr/local --strip-components=1 \
        --exclude='*/CHANGELOG.md' --exclude='*/LICENSE' --exclude='*/README.md' && \
    rm -f "node-v${NODE_VERSION}-linux-x64.tar.xz" && \
    node --version && npm --version

# ── Supply-chain: the dependency closure is VENDORED INTO THE IMAGE ─────────
# It used to be a host-local podman volume named kc-npm, populated by a
# documented "phase 1, network on, run once" step. That made the three node
# peers' results depend on whether the machine had ever run phase 1 — the exact
# defect csharp carried until 2026-09-02 (`--network` plus a kc-nuget volume),
# and the same class as containers/dart-toolchain and containers/ghc-toolchain.
# An adopter with no warm volume got a failure at install time, not a report.
#
# `turbowarp` was the sharper half: it ran with a NETWORK NAMESPACE and
# `npm install` (not `ci`), so its conformance result depended on the registry
# being reachable and on whatever `install` resolved that day.
#
# The cache is baked below from the peers' OWN committed lockfiles. Do NOT mount
# a volume at /npm-cache — it shadows the baked closure and restores the defect.
# Defaults below kill the noise + the network-y bits npm does opportunistically.
ENV npm_config_cache=/npm-cache \
    npm_config_audit=false \
    npm_config_fund=false \
    npm_config_update_notifier=false \
    npm_config_loglevel=warn \
    CI=true

# ── Seed /npm-cache from the peers' OWN committed lockfiles ────────────────
# The cache is derived from each peer's package-lock.json BY CONSTRUCTION, never
# from a hand-maintained restatement of the top-level pins in this file. That is
# the rule containers/dart-toolchain earned the hard way: pinning the DIRECT deps
# and letting the transitive ones float re-resolved source_maps 0.10.13 -> 0.10.14
# on a --no-cache rebuild, the image built perfectly, and the peer would not start.
#
# Only the manifest + lock files are copied, never the sources: this layer must
# not be invalidated by an ordinary edit to a peer. A peer that GAINS a lockfile
# and is not listed here fails its own offline run, which is the loud direction.
COPY protocol-generator/typescript/package.json \
     protocol-generator/typescript/package-lock.json \
     /seed/typescript/
COPY protocol-generator/node-red/src/package.json \
     protocol-generator/node-red/src/package-lock.json \
     /seed/node-red/
COPY protocol-generator/turbowarp/src/package.json \
     protocol-generator/turbowarp/src/package-lock.json \
     /seed/turbowarp/

# `npm ci` (never `npm install`) makes the committed lockfile authoritative: an
# unsatisfiable lockfile fails the IMAGE BUILD, which is the right place to find
# out.
#
# Then PROVE the closure is complete by wiping node_modules and re-running with
# --offline, which forbids every network round-trip. A seed that happens to be
# sufficient on the build host and short by one package for everyone else is the
# failure this whole layer exists to prevent, and only asking offline can tell
# the difference. (Verified the same way csharp's was: the first "offline" pass
# there passed only because a stale obj/ was still on disk.)
RUN set -eu; \
    for p in typescript node-red turbowarp; do \
      (cd "/seed/$p" && npm ci --no-audit --no-fund); \
    done; \
    for p in typescript node-red turbowarp; do \
      rm -rf "/seed/$p/node_modules"; \
      (cd "/seed/$p" && npm ci --offline --no-audit --no-fund); \
    done; \
    rm -rf /seed; \
    npm cache verify

WORKDIR /work

# ── How this is USED ────────────────────────────────────────────────────────
# Every run is sealed. There is no phase 1.
#
#    podman run --rm --network=none -v <repo>:/work:Z \
#      localhost/entity-core-keystone/node24:latest \
#      sh -c 'cd /work/protocol-generator/typescript && npm ci --offline && npx tsc -p tsconfig.json'
#
# --network=none guarantees nothing can fetch a transitive package mid-build (the
# "left-pad / minus-split" failure mode). The S4 conformance run needs loopback to
# the validate-peer oracle, not internet — peer + oracle share the container's
# loopback, still with NO registry egress.

# Sentinel
LABEL org.entity-core-keystone.role="node24"
LABEL org.entity-core-keystone.version="1"

CMD ["/bin/bash"]
