# Rust/cargo toolchain image — builds the codec C-ABI Rust implementation
# (ffi-generator/c-abi/entity-core-codec-ffi-rust) into libentitycore_codec.*
# plus the conformance harness.
#
# S1: builds run in this container, not on the host.
# S11: pin the toolchain to a version >= 30 days old. The exact NVR below is
#      what fedora:43 shipped at authoring; re-verify the >=30-day age when you
#      rebuild, and prefer pinning the base image by digest for full repro.
#      Crate pins live in the committed Cargo.lock (>=30d each, see
#      research/evaluations/ffi-rust.md).
#
# NOTE (R5, ffi-rust.md): a glibc cdylib won't load on hosts older than this
# base's glibc. For a *shipped* release artifact, rebuild on an old-glibc
# (manylinux-style) base. fedora:43 is fine for development + conformance.
# RE-PIN (2026-07-27, cohort image-rot sweep): rust/cargo 1.95.0-5.fc43 aged out of the
#   fedora:43 repos entirely (`No match for argument`), so this image would not build and the
#   FFI codec .so could not be produced — which in turn blocked the lean peer, whose harness
#   links against it. Re-pinned to 1.96.1-1.fc43, the current `updates` NVR and the same one
#   containers/rust-toolchain and containers/datalog-toolchain now carry.
# KOJI-PIN (2026-07-27, closing the rot class): rust/cargo fetched from Koji's permanent
# build archive (containers/koji-fetch.sh), not the rolling dnf repo — see
# c-toolchain's Containerfile for the full rationale. SHA-256 recorded at fetch time.
# Base pinned BY DIGEST, not by tag (fedora:43, resolved 2026-08-27).
# A tag is republished in place; a digest is not. Pinning the tag meant every
# image in this tree floated on whatever the registry served that day, which is
# not reproducible for anyone pulling the repo.
FROM registry.fedoraproject.org/fedora@sha256:6e1245e9a4a72ec879b9d681ebb464a6e9fd93eea36b4506d438aceb95a7da0b

# rust + cargo from the distro; gcc/cc needed as the linker for cdylib/staticlib.
# pkgconf + glibc-static help with fully-static staticlib consumers.
# Pinned NVR (S11): what fedora:43 shipped at authoring (2026-06-07). Re-verify
# the >=30-day age + re-pin deliberately on rebuild; prefer base-image digest pin.
COPY containers/koji-fetch.sh /usr/local/bin/koji-fetch.sh
RUN chmod +x /usr/local/bin/koji-fetch.sh \
    && koji-fetch.sh rust 1.96.1 1.fc43 \
        rust:d008ed30fa93406d30a044bbcb360f1d744796e428921b78140982be232d2b9b \
        cargo:91c098b91ad70e3aa1470f9bb6c0b8c5b8475dcc84526a5ec909873f550263ff \
        rust-std-static:fd28b8fd1266dab0df34cdc058257a71ea00b7b102b92d3da66468d41108600a \
    && dnf install -y /tmp/rpms/*.rpm gcc \
    && rm -rf /tmp/rpms \
    && dnf clean all

# Keep cargo's registry/cache on a mountable path so repeated runs don't refetch
# crates (the conformance loop runs this many times). Mount a volume at /cargo.
ENV CARGO_HOME=/cargo \
    CARGO_TERM_COLOR=never

WORKDIR /work
