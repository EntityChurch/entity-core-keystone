# ARM64 (AArch64) assembly toolchain image — cross-assembles + cross-links the hand-authored
# aarch64 assembly peer (entity-core-protocol-asm-arm64) and RUNS it under qemu-user, sharing
# one loopback with the NATIVE x86-64 Go validate-peer oracle. First ISA port off the x86-64
# template (protocol-generator/asm-x86_64) — see that peer's arch/OPTIONS-AND-ISA-MAP.md, Axis A.
#
# Deliberately THIN, three capabilities:
#   1. CROSS-ASSEMBLE/LINK the aarch64 peer:
#        - binutils-aarch64-linux-gnu → aarch64 `as` (GAS, native ARM syntax) + `ld`
#        - gcc-aarch64-linux-gnu       → LINK DRIVER ONLY (crt0 + __libc_start_main + the
#                                        aarch64 dynamic-linker path). No peer C is compiled.
#        - sysroot-aarch64-fc43-glibc  → the aarch64 glibc sysroot the cross driver links against
#   2. CROSS-BUILD the codec .so for aarch64 (the FFI×ISA cost, ISA-MAP "load-bearing finding"):
#        - cmake + make                → drives ffi-generator/c-abi/entity-core-codec-ffi-c
#        - aarch64 libsodium (static)  → NOT packaged as a cross rpm (fedora ships libsodium only
#                                        for x86_64/i686). Pulled as the AARCH64 rpm via
#                                        `dnf download --forcearch aarch64` and unpacked INTO the
#                                        cross sysroot, so `--sysroot` finds sodium.h + libsodium.a.
#                                        (This corrects the kickoff handoff's "libsodium-devel cross
#                                        is available" — it is not; forcearch+sysroot is the path.)
#   3. RUN the aarch64 peer under emulation:
#        - qemu-user-static-aarch64    → `qemu-aarch64-static ./peer`, invoked EXPLICITLY (not via
#                                        binfmt) so it is robust regardless of host registration.
#
# The x86-64 Go `validate-peer` oracle is a native fedora:43 ELF that runs directly in this same
# container, so oracle + qemu-emulated peer share one loopback → `--network=none` seals the run.
#
# S11: pinned NVRs = what fedora:43 shipped at authoring (2026-07-15). Re-verify the >=30-day age
#      + re-pin on rebuild; prefer a base-image digest pin for full reproducibility.
#
# Build:
#   podman build -t entity-core-keystone/asm-arm64-toolchain:latest \
#     -f containers/asm-arm64-toolchain/Containerfile .
#
# Dev loop (cross-assemble + link + run self-check under qemu, sealed offline):
#   podman run --memory=4g --memory-swap=4g --pids-limit=2048 --cpus=4 --rm --network=none \
#     -v "$PWD":/work:Z -w /work/protocol-generator/asm-arm64 \
#     entity-core-keystone/asm-arm64-toolchain:latest make s2
FROM registry.fedoraproject.org/fedora:43

# Cross assembler (GAS) + cross link driver + aarch64 glibc sysroot + qemu-user + codec build deps.
RUN dnf install -y --setopt=install_weak_deps=False \
        binutils-aarch64-linux-gnu-2.45-1.fc43 \
        gcc-aarch64-linux-gnu-15.2.1-1.fc43 \
        sysroot-aarch64-fc43-glibc-2.42-13.fc43 \
        qemu-user-static-aarch64-2:10.1.5-1.fc43 \
        cmake-3.31.11-1.fc43 \
        make-1:4.4.1-11.fc43 \
        dnf-plugins-core \
        cpio \
        file \
        findutils \
        which \
    && dnf clean all

# The AArch64 glibc sysroot (from sysroot-aarch64-fc43-glibc) lives under the aarch64-REDHAT-linux
# triple, NOT the aarch64-LINUX-gnu triple the gcc cross-driver defaults to — so we pin --sysroot
# to it explicitly everywhere (SYSROOT below). It ships glibc headers/libs under usr/{include,lib,lib64}
# but no /lib /lib64 compat symlinks, so a dynamically-linked aarch64 binary requests the interpreter
# at /lib/ld-linux-aarch64.so.1 which QEMU_LD_PREFIX=<sysroot> cannot resolve. Add the usrmerge
# symlinks so qemu-user finds the guest loader + libc. (Both gotchas are ISA-port FFI×toolchain
# findings, logged in the peer's SPEC-AMBIGUITY-LOG.)
#
# aarch64 libsodium (static + headers) is unpacked INTO that same sysroot: fedora has NO cross
# libsodium package (only x86_64/i686 — this corrects the kickoff handoff's "libsodium-devel cross
# is available"). The aarch64 rpm fetched via `dnf download --forcearch aarch64` and cpio-extracted
# is the self-contained equivalent; --sysroot then resolves both glibc and sodium.h/libsodium.a.
RUN SYSROOT=/usr/aarch64-redhat-linux/sys-root/fc43 \
    && ln -sf usr/lib   "$SYSROOT/lib" \
    && ln -sf usr/lib64 "$SYSROOT/lib64" \
    && mkdir -p /tmp/aa \
    && dnf download --forcearch aarch64 --destdir /tmp/aa \
         libsodium-1.0.22-1.fc43 \
         libsodium-static-1.0.22-1.fc43 \
         libsodium-devel-1.0.22-1.fc43 \
    && for r in /tmp/aa/*.aarch64.rpm; do \
         rpm2cpio "$r" | cpio -idm -D "$SYSROOT"; \
       done \
    && rm -rf /tmp/aa \
    && test -f "$SYSROOT/usr/include/sodium.h" \
    && test -f "$SYSROOT/usr/lib64/libsodium.a" \
    && test -e "$SYSROOT/lib/ld-linux-aarch64.so.1"

ENV CMAKE_COLOR_DIAGNOSTICS=OFF

WORKDIR /work

LABEL org.entity-core-keystone.role="asm-arm64-toolchain"
LABEL org.entity-core-keystone.version="1"

CMD ["/bin/bash"]
