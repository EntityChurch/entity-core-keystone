# x86-64 assembly toolchain image — assembles + links the hand-authored assembly peer
# (entity-core-protocol-asm-x86_64) per protocol-generator/asm-x86_64/profile.toml.
#
# Deliberately THIN. The peer is hand-written GAS/AT&T assembly; the only tools needed
# are the assembler + a link driver:
#   - binutils  → `as` (GAS assembler) + `ld`
#   - gcc       → LINK DRIVER ONLY (crt0 + __libc_start_main + dynamic-linker path).
#                 No peer C is compiled; gcc is used purely to link the asm objects
#                 against libc + the codec .so with correct startup. (A-ASM-001.)
#   - glibc-static → optional: lets the peer link the codec .a into a self-contained
#                 ELF (the documented static alternative to the dynamic default).
# No LLVM, no NASM (GAS is the zero-new-dependency assembler — AGENTS-STANDARD minimal deps).
#
# The FFI target libentitycore_codec.{so,a} + the C-ABI header are NOT baked in: they are
# committed repo build outputs under ffi-generator/, reached through the mounted /work
# tree at build/link time — the same pattern the peers use for the /work/output/s4-oracles
# binaries. Keeps the image reproducible and provenance-clean (the lib is versioned in-repo,
# not in the image).
#
# S11: pinned NVRs = what fedora:43 shipped at authoring (matches containers/c-toolchain).
#      Re-verify the >=30-day age + re-pin on rebuild; prefer a base-image digest pin for
#      full reproducibility.
#
# Build:
#   podman build -t entity-core-keystone/asm-x86_64-toolchain:latest \
#     -f containers/asm-x86_64-toolchain/Containerfile .
#
# Dev loop (assemble + link + self-check, sealed offline):
#   podman run --memory=4g --memory-swap=4g --pids-limit=2048 --cpus=4 --rm --network=none \
#     -v "$PWD":/work:Z -w /work/protocol-generator/asm-x86_64 \
#     entity-core-keystone/asm-x86_64-toolchain:latest make s2
# RE-PIN (2026-07-27, cohort image-rot sweep): the fedora:43 `updates` repo no longer
#   serves gcc/gcc-c++/gcc-gnat/libstdc++*/libasan/libubsan 15.2.1-7.fc43 or
#   binutils 2.45.1-4.fc43 — `dnf install` failed with `No match for argument`, so the
#   image would not build and the peer could not be validated at all. Verified against
#   `dnf list --showduplicates` inside fedora:43 on 2026-07-27: the surviving NVRs are
#   15.2.1-2.fc43 (base `fedora`) and 15.3.1-1.fc43 (`updates`) for the gcc family, and
#   2.45.1-5.fc43 (`updates`) for binutils. Re-pinned to the freshest reviewed distro
#   build per the S11 distro-channel pin-for-repro rule. Same rot that took out
#   containers/rust-toolchain (rustfmt-1.96.0-1.fc43); pinning exact NVRs against a
#   rolling `updates` repo is reproducible only until the NVR is superseded.
# KOJI-PIN (2026-07-27, closing the rot class): gcc/binutils fetched from Koji's
# permanent build archive (containers/koji-fetch.sh), not the rolling dnf repo — see
# c-toolchain's Containerfile for the full rationale. SHA-256 recorded at fetch time.
# Base pinned BY DIGEST, not by tag (fedora:43, resolved 2026-08-27).
# A tag is republished in place; a digest is not. Pinning the tag meant every
# image in this tree floated on whatever the registry served that day, which is
# not reproducible for anyone pulling the repo.
FROM registry.fedoraproject.org/fedora@sha256:6e1245e9a4a72ec879b9d681ebb464a6e9fd93eea36b4506d438aceb95a7da0b

# Assembler (GAS) + link driver + optional static libc. Pinned NVRs match c-toolchain.
COPY containers/koji-fetch.sh /usr/local/bin/koji-fetch.sh
RUN chmod +x /usr/local/bin/koji-fetch.sh \
    && koji-fetch.sh gcc 15.3.1 1.fc43 \
        gcc:5361a544a8412eecfdfb1dc117749b637bfcd19de41eaa9468f94cade6cf1824 \
    && koji-fetch.sh binutils 2.45.1 5.fc43 \
        binutils:a3971b2f8c7b97b8f6e7000223226dc47d4ef8fa0d5b585791a3cf1f9f975431 \
    && koji-fetch.sh glibc 2.42 16.fc43 \
        glibc-static:0e143590abfa2ee7b718bd900671b807061b84397c4511a15cfc96ee43c5644d \
        glibc-devel:f587060e9d2714a5e2595d15d75933a3ab4e125fcf103b1cf130588a2221fffa \
    && koji-fetch.sh make 4.4.1 11.fc43 \
        make:15efaea3972cca7f43e9619af676498a3e586d312b59acfc3715d9fb595c06d2 \
    && dnf install -y \
            /tmp/rpms/*.rpm \
            findutils \
            which \
    && rm -rf /tmp/rpms \
    && dnf clean all

ENV CMAKE_COLOR_DIAGNOSTICS=OFF

WORKDIR /work

LABEL org.entity-core-keystone.role="asm-x86_64-toolchain"
LABEL org.entity-core-keystone.version="1"

CMD ["/bin/bash"]
