# Go toolchain image — builds keystone-local Go tooling (the interim codec
# oracle) and, when needed, entity-core-go binaries (validate-peer,
# wire-conformance) for conformance.
#
# S1: builds run in this container, not on the host.
# S11: pin the toolchain to a version >= 30 days old. golang 1.25.x is required
#      (entity-core-go/core/go.mod declares `go 1.25.0`). The exact NVR below is
#      what fedora:43 shipped at authoring; re-verify the >=30-day age when you
#      rebuild, and prefer pinning the base image by digest for full repro.
# RE-PIN (2026-08-17, register-reserved-pattern fix session): golang-1.25.10-*.fc43
#   rotted out of the `updates` repo metadata (`No match for argument`) — same class
#   of rot AGENTS.md documents for gcc/binutils/rust/dotnet, first time observed for
#   golang. Verified via `dnf list --showduplicates golang` inside fedora:43: the
#   surviving NVRs are 1.25.1-2.fc43 (base `fedora`) and 1.25.12-1.fc43 (`updates`).
#   Re-pinned to the freshest reviewed distro build per the S11 pin-for-repro rule.
#   Plain dnf pin (not yet converted to koji-fetch.sh) since this is the first
#   observed rot for golang, per AGENTS.md's "convert the first time it rots" rule.
# Base pinned BY DIGEST, not by tag (fedora:43, resolved 2026-08-27).
# A tag is republished in place; a digest is not. Pinning the tag meant every
# image in this tree floated on whatever the registry served that day, which is
# not reproducible for anyone pulling the repo.
FROM registry.fedoraproject.org/fedora@sha256:6e1245e9a4a72ec879b9d681ebb464a6e9fd93eea36b4506d438aceb95a7da0b

COPY containers/koji-fetch.sh /usr/local/bin/koji-fetch.sh
RUN chmod +x /usr/local/bin/koji-fetch.sh \
    && koji-fetch.sh golang 1.25.12 1.fc43 \
        golang:182439cc636a5cb6e932bf066c8ad9618a5dba57336077760fe195b12fc7124d \
        golang-bin:a380528f1b721488a3494cef0ddd205917784d4f5a6c6504f4409795b7c62748 \
        golang-src:518a8c9b41d0852cd013a5140243db7fb416d72f550250742f99e07c552675dc \
    && dnf install -y \
            /tmp/rpms/*.rpm \
            git \
    && rm -rf /tmp/rpms \
    && dnf clean all

ENV GOTOOLCHAIN=local \
    GOFLAGS=-mod=mod

WORKDIR /work
