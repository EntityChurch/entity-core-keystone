# COBOL toolchain image — GnuCOBOL (cobc) on fedora:43.
#
# Purpose: the COBOL peer (entity-core-protocol-cobol) is an FFI-everything peer
# — no native COBOL CBOR or crypto exists, so it consumes libentitycore_codec
# over the codec C-ABI (ffi-generator/c-abi/spec/). GnuCOBOL compiles COBOL ->
# C -> native via gcc, and its CALL ... USING BY REFERENCE/BY VALUE maps onto the
# C ABI, so the same image both compiles COBOL and links the codec .so.
#
# S1: builds + conformance run in this container, not on the host.
# S11: pin every package to a version that was >= 30 days old at authoring
#      (2026-06-18). The NVRs below are what fedora:43 shipped then; re-verify the
#      >=30-day age + re-pin deliberately on rebuild, and prefer pinning the base
#      image by digest for full repro.
#
# GnuCOBOL PIN NOTE (S11): gnucobol-3.2-8.fc43 — buildtime 2025-07-24 (~11 months
# old at authoring), well clear of the 30-day floor. Upstream GnuCOBOL 3.2 is the
# 2022 stable line. The single `gnucobol` package provides cobc + cobcrun +
# /usr/include/libcob.h (no separate -devel on fedora:43).
# RE-PIN (2026-07-27, cohort image-rot sweep): the fedora:43 `updates` repo no longer
#   serves gcc/gcc-c++/gcc-gnat/libstdc++*/libasan/libubsan 15.2.1-7.fc43 or
#   binutils 2.45.1-4.fc43 — `dnf install` failed with `No match for argument`, so the
#   image would not build and the peer could not be validated at all. Verified against
#   `dnf list --showduplicates` inside fedora:43 on 2026-07-27: the surviving NVRs are
#   15.2.1-2.fc43 (base `fedora`) and 15.3.1-1.fc43 (`updates`) for the gcc family, and
#   2.45.1-5.fc43 (`updates`) for binutils. Re-pinned to the freshest reviewed distro
#   build per the S11 distro-channel pin-for-repro rule. Same rot that took out
#   containers/rust-toolchain (rustfmt-1.96.0-1.fc43); pinning exact NVRs against a
#   rolling `updates` repo is reproducible only until the NVR is superseded.
# KOJI-PIN (2026-07-27, closing the rot class): gcc/binutils fetched from Koji's
# permanent build archive (containers/koji-fetch.sh), not the rolling dnf repo — see
# c-toolchain's Containerfile for the full rationale. SHA-256 recorded at fetch time.
FROM registry.fedoraproject.org/fedora:43

# GnuCOBOL compiler + runtime, the C toolchain it lowers through, and the C-ABI
# codec's link-time deps (libsodium present so a locally-built libentitycore_codec
# resolves). Pinned NVRs (S11): what fedora:43 shipped at authoring (2026-06-18);
# re-verify age + re-pin on rebuild.
COPY containers/koji-fetch.sh /usr/local/bin/koji-fetch.sh
RUN chmod +x /usr/local/bin/koji-fetch.sh \
    && koji-fetch.sh gcc 15.3.1 1.fc43 \
        gcc:5361a544a8412eecfdfb1dc117749b637bfcd19de41eaa9468f94cade6cf1824 \
    && koji-fetch.sh binutils 2.45.1 5.fc43 \
        binutils:a3971b2f8c7b97b8f6e7000223226dc47d4ef8fa0d5b585791a3cf1f9f975431 \
    && dnf install -y \
        /tmp/rpms/*.rpm \
        gnucobol-3.2-8.fc43 \
        make-1:4.4.1-11.fc43 \
        libsodium-1.0.22-1.fc43 \
        libsodium-devel-1.0.22-1.fc43 \
    && rm -rf /tmp/rpms \
    && dnf clean all

WORKDIR /work
