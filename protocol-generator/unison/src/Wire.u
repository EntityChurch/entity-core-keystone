-- entity-core-protocol-unison — wire framing (§1.6) + the two message builders
-- (§3.2 EXECUTE / §3.3 EXECUTE_RESPONSE). Frame := [4-byte BE length][CBOR
-- payload]; the payload is a CBOR-encoded envelope (§3.1). Pure layer only — the
-- blocking socket read/write lives in Transport.u (the IO edge). Frame length is
-- explicit 4-byte big-endian (`explicit_endianness`).

-- §1.6 SHOULD bound — 16 MiB (§4.10 informative default).
maxFrame : Nat
maxFrame = 16777216

frameHeader : Nat -> Bytes
frameHeader len = Bytes.encodeNat32be len

parseFrameLength : Bytes -> Nat
parseFrameLength hdr =
  b0 = byteAt hdr 0
  b1 = byteAt hdr 1
  b2 = byteAt hdr 2
  b3 = byteAt hdr 3
  (b0 * 16777216) + (b1 * 65536) + (b2 * 256) + b3

-- ── envelope <-> frame ────────────────────────────────────────────────────────

envelopeOfFrame : Bytes -> Either CodecError Envelope
envelopeOfFrame payload = match decode payload with
  Left e -> Left e
  Right v -> envelopeOfCbor v

-- §6.3 rejection reporting: recover ONLY the request_id from a frame the strict decoder
-- rejected, so the rejection can be delivered as a correlated `400 non_canonical_ecf`
-- response instead of silence. The frame stays rejected — nothing else is read out of it.
-- None when even the request_id is unrecoverable (an unattributable frame, where silence
-- is the only option left).
--
-- The envelope and entity-wrapper shapes are fixed maps with no legal tag position (§6.3),
-- so a frame whose ONLY defect is a tag inside some entity's `data` still has a
-- structurally sound root — which is exactly the case this recovers.
salvageRequestId : Bytes -> Optional Text
salvageRequestId payload = match decodeSalvage payload with
  Left _ -> None
  Right v -> match mapField v "root" with
    Some rootV -> match mapField rootV "data" with
      Some dataV -> match mapField dataV "request_id" with
        Some (VText rid) -> Some rid
        _ -> None
      _ -> None
    _ -> None

-- §4.11's code assignment, from this codec's own error constructors. One function so the
-- mapping cannot drift between the call sites that need it.
--
-- §4.11 rules `non_canonical_ecf` non-conformant ON THE FRAMING ARM and gives its reason
-- in the same sentence: ENTITY-CBOR-ENCODING defines that code for CBOR **tag-policy
-- violations specifically**, which §6.3 still MUSTs at decode time. So ONLY `TagRejected`
-- keeps it. `NonCanonicalEcf` and `DuplicateKey` are real canonicalization faults whose
-- NAMES match the code and which nonetheless owe `invalid_request` -- the rows are
-- disjoint by CAUSE, and reading the constructor name as the mapping is the mistake.
causeCode : CodecError -> Text
causeCode e = match e with
  TagRejected _ -> "non_canonical_ecf"
  IncludedKeyMismatch _ -> "hash_mismatch"
  _ -> "invalid_request"

frameOfEnvelope : Envelope -> Bytes
frameOfEnvelope env =
  payload = encode (envelopeToCbor env)
  bappend (frameHeader (Bytes.size payload)) payload

-- ── EXECUTE_RESPONSE builder (§3.3) ───────────────────────────────────────────

makeResponse : Text -> Nat -> Entity -> Entity
makeResponse requestId status result =
  makeEntity "system/protocol/execute/response"
    (VMap [ (VText "request_id", VText requestId)
          , (VText "status", VUInt status)
          , (VText "result", entityToCbor result) ])

-- ── EXECUTE builder (§3.2) — the §6.13b handler outbound seam + the smoke client ─

makeExecute : Text -> Text -> Text -> Entity -> Optional Value -> Bytes -> Bytes -> Entity
makeExecute requestId uri operation params resource author capability =
  base = [ (VText "request_id", VText requestId)
         , (VText "uri", VText uri)
         , (VText "operation", VText operation)
         , (VText "params", entityToCbor params)
         , (VText "author", VBytes author)
         , (VText "capability", VBytes capability) ]
  withRes = match resource with
    Some r -> base :+ (VText "resource", r)
    None -> base
  makeEntity "system/protocol/execute" (VMap withRes)

-- system/protocol/error result entity (§3.3).
errorResult : Optional Text -> Text -> Entity
errorResult message code =
  base = [ (VText "code", VText code) ]
  withMsg = match message with
    Some m -> base :+ (VText "message", VText m)
    None -> base
  makeEntity "system/protocol/error" (VMap withMsg)

-- Empty-params shape (§3.2): primitive/any whose data is the canonical empty map
-- (the 0xA0 encoding, N3).
emptyParams : Entity
emptyParams = makeEntity "primitive/any" (VMap [])
