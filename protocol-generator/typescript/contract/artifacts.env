# What tools/peer-contract/run.sh records in the report's delivery manifest for this peer.
# The bare host is the peer's own dist/test/host.js (runHost(argv, no-op)); the contract host
# is compiled into contract/host/output/pkg/ by run-contract.sh. Both are built output.
KPC_IMAGE="entity-core-keystone/node24:latest"
KPC_ARTIFACTS="bare_host=protocol-generator/typescript/dist/test/host.js peer_host_lib=protocol-generator/typescript/dist/src/host.js contract_host=protocol-generator/typescript/contract/host/output/pkg/dist/main.js"
