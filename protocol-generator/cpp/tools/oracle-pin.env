# Oracle pin for entity-core-protocol-cpp conformance (S4/S5).
#
# The validate-peer / entity-peer Go oracle is built from a read-only `git archive`
# extract of the READ-ONLY entity-core-go source at this commit, OUTSIDE the go repo
# (CGO_ENABLED=0, GOWORK=off, in the go-toolchain image). The oracle ELF is gitignored
# (a local tool); this file pins its provenance + the core-gate hash so a rebuild is
# verifiable. See status/CONFORMANCE-REPORT.md for the rebuild runbook.
#
# cc1970f cohort baseline (public go HEAD after the 2026-07-10 mirror re-normalization;
# see tools/oracle-pin.env + CONFORMANCE-MATRIX §3). The original pin e8524ed no longer
# resolves after the public mirror rewrote history; cc1970f's core gate is the SAME gate
# (the two profile.go blobs differ only by a V8 release-prep comment reword, which leaves
# the normalized core-gate fingerprint below untouched — so the verdict carries).

ORACLE_REPO=entity-core-go
ORACLE_COMMIT=cc1970f
ORACLE_SPEC_VERSION=v0.8.0
# AUTHORITATIVE anchor: normalized core-gate fingerprint (category set + 53-type floor,
# comment/format-invariant). run-s4 / the conformance report assert this matches.
CORE_GATE_FINGERPRINT=8261a033fe1af56b1973fefb07ba8fcbdfd0867c17707275dbbd453bdc9bf745
# informational only (raw file bytes; moves on a comment reword — NOT the anchor):
CORE_GATE_SHA256=74e04e3a935a1c4f382b8f25606477ac457faa0606939317a4ebf133760db2cf
# retired: e8524ed (raw sha256 e09a865…; unreproducible after mirror history rewrite)

# Codec fixture provenance (S2): wire-conformance build-fixture at go HEAD 71b6ba8 emits
# conformance-vectors-v1.cbor byte-identical to the vendored corpus (sha 9695b1f1...).
WIRE_CONFORMANCE_COMMIT=be54baf
CODEC_CORPUS_VERSION=v0.8.0-f29f30
CODEC_CORPUS_SHA256_PREFIX=9695b1f1
