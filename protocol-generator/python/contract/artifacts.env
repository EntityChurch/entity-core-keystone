# What tools/peer-contract/run.sh records in the report's delivery manifest for this peer.
# The artifacts are the two WHEELS run-contract.sh builds (deterministically: contract/wheel.py
# sorts entries and fixes zip timestamps) and installs before the driver runs — the peer's
# distribution and the contract host's.
KPC_IMAGE="entity-core-keystone/python-toolchain:latest"
KPC_ARTIFACTS="peer_wheel=protocol-generator/python/output/contract/entity_core_protocol_python-0.1.0-py3-none-any.whl contract_host_wheel=protocol-generator/python/output/contract/entity_core_protocol_python_contract_host-0.1.0-py3-none-any.whl"
