# Compiled native-function shim (the only compiled artifact; rebuilt by `make shim`).
src/ext/*.so
# Gate run logs (regenerated by `make conf` / `make unit` / `make selftest`).
build-conf.log
build-unit.log
build-selftest.log
# Source distribution tarball tree.
dist/
# GNU APL interactive history (written on run).
.apl.history
