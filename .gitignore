# Per-machine podman resource-cap overrides (RESOURCE-CAPS.md §4a) — never committed.
# caps.local.mk → Makefile (image builds); caps.local.sh → run-scripts (tools/podman-caps.sh).
caps.local.mk
caps.local.sh

# Build output
**/output/
**/target/
**/bin/
# …but the OCaml peer uses bin/ as a dune SOURCE dir (the conformance host), not a
# compiled-binary dir — keep its source tracked (build artifacts live in _build/).
!protocol-generator/ocaml/bin/
!protocol-generator/ocaml/bin/**
# …same for the generated Rust peer: src/bin/ is the cargo binary-target SOURCE dir
# (the wire-conformance harness), not a compiled-binary dir (those live in target/).
!protocol-generator/rust/src/bin/
!protocol-generator/rust/src/bin/**
# …and the COBOL peer keeps its host entrypoint SOURCE in bin/ (bin/host.cob — the
# S4 conformance host's PROGRAM-ID, compiled by `make host` into build/host, not a
# committed binary). Un-ignore the source so the entrypoint is tracked.
!protocol-generator/cobol/bin/
!protocol-generator/cobol/bin/**
# …and the APL peer keeps its host entrypoint SOURCE in bin/ (bin/peer.apl — the
# workspace loader + ⎕FIO dispatch loop that `apl --script` runs and validate-peer
# drives; interpreted, not a compiled binary). Un-ignore the source so it is tracked.
!protocol-generator/apl/bin/
!protocol-generator/apl/bin/**
# …and the Smalltalk peer keeps its peer entry SOURCE in bin/ (bin/peer.st — a live-image
# doit, NOT a compiled binary; the peer image itself is *.image, separately gitignored).
# Un-ignore the source so the peer entrypoint is tracked.
!protocol-generator/smalltalk/bin/
!protocol-generator/smalltalk/bin/**
# …and the Fortran peer keeps its PROGRAM entry SOURCE in bin/ (bin/peer.f90 — the
# PROGRAM peer that `make peer` compiles into build/peer and validate-peer drives; the
# .f90 source, not a committed binary). Un-ignore the source so the entrypoint is tracked.
!protocol-generator/fortran/bin/
!protocol-generator/fortran/bin/**
# …and the Julia peer keeps its peer entry SOURCE in bin/ (bin/peer.jl — the script
# validate-peer drives via `julia bin/peer.jl --name …`; interpreted/JIT, not a compiled
# binary). Un-ignore the source so the entrypoint is tracked.
!protocol-generator/julia/bin/
!protocol-generator/julia/bin/**
# …and the Forth peer keeps its peer entry SOURCE in bin/ (bin/peer.fs — the CLI arg
# parser + main word that `gforth bin/peer.fs --port … --name …` runs; interpreted, not
# a compiled binary). Un-ignore the source so the entrypoint is tracked. Found 2026-08-17
# (W-REGISTER-GUARD remediation): this exception was missing entirely, so bin/peer.fs was
# NEVER committed since S3 (0267303) despite the peer being S4/S5-complete — every prior
# session's green report was measured against a stray untracked local file, invisible to
# a fresh clone/worktree. Recovered from the primary checkout's untracked copy.
!protocol-generator/forth/bin/
!protocol-generator/forth/bin/**
**/obj/
**/build/
**/dist/
**/dist-native/

# Containers
*.tar
*.tar.gz

# .NET
**/*.csproj.user
**/.vs/

# Rust
# Default library convention ignores Cargo.lock, but S11 requires committed
# lockfiles for reproducibility — un-ignore the codec FFI impls (they ARE the
# pinned-dependency deliverables).
**/Cargo.lock
!ffi-generator/c-abi/entity-core-codec-ffi-rust/Cargo.lock
# The generated Rust protocol peer is a binary-bearing deliverable — S11 requires
# the full transitive closure committed (curve25519-dalek held at 4.1.3).
!protocol-generator/rust/Cargo.lock
# The wasmtime-AOT wasm peer — same S11 rule; pins wasi 0.11.1 + the shared crypto closure.
!protocol-generator/rust-wasm-wasmtime/Cargo.lock
# The Datalog peer (Rust host + Ascent) — S11 requires the full ascent transitive
# closure (30 packages) committed at S2, frozen before S3 authors the rule interior.
!protocol-generator/datalog/Cargo.lock

# Cargo registry/build cache (the mountable CARGO_HOME used by the conformance loop) —
# a local artifact, never committed. The cache lives at containers/cargo/ (mounted at
# /cargo); ignore everything there EXCEPT the tracked Containerfile.
.cargo-cache/
containers/cargo/*
!containers/cargo/Containerfile

# Node
**/node_modules/

# Python
**/__pycache__/
**/*.pyc
**/.venv/

# JVM
**/*.class

# Gradle (Kotlin peer) — transient build cache / daemon state. The build dir is
# already covered by **/build/ above; the gradle.lockfile (S11 pinned deps) IS
# committed and must NOT be ignored.
**/.gradle/

# OCaml / dune
**/_build/
**/*.install
**/.merlin

# IDE
.idea/
.vscode/
*.swp
*~

# OS
.DS_Store
Thumbs.db
